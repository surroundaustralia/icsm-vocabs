        ] ;
    schema:creator
        [
            a schema:Organization ;
            schema:name "Place Names Working Group" ;
            schema:url ""^^xsd:anyURI ;
        ] ;
    schema:dateCreated "2026-10-16"^^xsd:date ;
    schema:dateModified "2026-10-16"^^xsd:date ;
