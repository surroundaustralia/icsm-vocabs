PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

:aad
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Geographic name status types utilised by Australian Antarctic Division"@en ;
    skos:inScheme cs: ;
    skos:member
        :disappeared ,
        :historical ,
        :official ,
        :recorded ;
    skos:prefLabel "Australian Antarctic Division's Geographic Name Status Types"@en ;
.

:act
