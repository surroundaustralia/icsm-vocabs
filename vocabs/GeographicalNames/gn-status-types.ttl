        cs:unapproved ,
        cs:reconsider ,
        cs:review-applicant ,
        cs:review-secretariat ,
        cs:withdrawn ;
    skos:prefLabel "Proposed"@en ;
    skos:topConceptOf cs: ;
.

cs:
    a skos:ConceptScheme ;
    owl:versionIRI :0.1 ;
    skos:definition "Set of terms that classify the status of geographical names"@en ;
    skos:hasTopConcept
        cs:collected ,
        cs:confidential ,
        cs:disallowed ,
        cs:historical ,
        cs:official ,
        cs:proposed ,
        cs:recorded ;
    skos:historyNote "Experimental vocab developed by Qld for discussion by the PNWG" ;
    skos:prefLabel "Geographical Name Status Type"@en ;
    prov:qualifiedAttribution
        [
            prov:agent
                [
                    a schema:Person ;
                    schema:email ""^^xsd:anyURI ;
                    schema:name "ICSM" ;
                ] ;
